`timescale 1ns/1ps

module tb_fir_da_4tap;

reg clk;
reg rst;
reg [3:0] x_in;
wire signed [11:0] y_out;

fir_da_4tap uut (
    .clk(clk),
    .rst(rst),
    .x_in(x_in),
    .y_out(y_out)
);

// Clock
initial clk = 0;
always #5 clk = ~clk;

// Stimulus
initial begin
    clk = 0;
    rst = 1;

    // ✅ FIX: set input BEFORE simulation starts
    x_in = 4;

    #20 rst = 0;   // release reset

    // keep running
    #300 $finish;
end

endmodule
